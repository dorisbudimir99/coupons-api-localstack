{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndUpdateCoupons",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/coupons",
        "arn:aws:dynamodb:us-east-1:000000000000:table/coupons/index/*"
      ]
    }
  ]
}
